# Copy to backend/.env and fill in real values.

MONGO_URL=mongodb://localhost:27017
DB_NAME=lir_database

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=change-this-admin-password

OWNER_EMAIL=you@yourdomain.com
EMAIL_FROM_NAME=Louisiana Industrial Readiness
EMAIL_FROM=Louisiana Industrial Readiness <hello@yourdomain.com>
EMAIL_REPLY_TO=hello@yourdomain.com
RESEND_API_KEY=

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cookie settings: use secure=true + samesite=none only if frontend and API are on different HTTPS origins
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Leave blank to run local demo checkout (no real charge). Use sk_test_... then sk_live_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENABLE_AUTOMATIC_TAX=false
